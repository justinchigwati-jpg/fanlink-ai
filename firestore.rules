rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'justinchigwati@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    function isValidUser(data) {
      return data.keys().hasAll(['id', 'displayName', 'username', 'accountType']) &&
             data.id is string && data.id.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 80 &&
             data.username is string && data.username.size() <= 40 &&
             data.accountType in ['fan', 'creator', 'artist', 'athlete'];
    }

    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().id == userId;
      allow update: if (
        isAdmin() ||
        (
          isOwner(userId) && isValidUser(incoming()) &&
          incoming().id == existing().id &&
          // Normal users cannot directly modify administrative status, verification, badges, FanCoins, or creator revenues
          (!incoming().diff(existing()).affectedKeys().hasAny(['isAdmin', 'role', 'isVerified', 'badge', 'coinsBalance', 'creatorEarningsEur', 'pendingEarningsEur']) || isAdmin())
        )
      );
      allow delete: if isAdmin() || isOwner(userId);

      // Isolated Private PII and Wallet Subcollection
      match /private/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId) || isAdmin();
      }

      // User Settings & Privacy preferences (strictly private)
      match /settings/{settingId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Personal Activities & Actions (strictly private)
      match /activities/{activityId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // User Notifications
      match /notifications/{notifId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isSignedIn();
        allow update, delete: if isOwner(userId) || isAdmin();
      }
    }

    // --- Posts Collection ---
    function isValidPost(data) {
      return data.keys().hasAll(['id', 'authorId', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.authorId is string && data.authorId.size() <= 128 &&
             data.content is string && data.content.size() <= 2000;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPost(incoming()) && incoming().authorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          incoming().authorId == existing().authorId &&
          (
            // Author updating content
            (isOwner(existing().authorId) && isValidPost(incoming())) ||
            // Users liking / incrementing counters
            incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'likedByCurrentUser'])
          )
        )
      );
      allow delete: if isSignedIn() && (isAdmin() || isOwner(existing().authorId));

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && incoming().authorId == request.auth.uid && incoming().content.size() <= 500;
        allow delete: if isSignedIn() && (isAdmin() || isOwner(existing().authorId) || isOwner(get(/databases/$(database)/documents/posts/$(postId)).data.authorId));
      }
    }

    // --- Football Matches Collection ---
    match /matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- Match Predictions Collection ---
    match /predictions/{predId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // --- Conversations and Messages ---
    match /conversations/{convId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid && incoming().text.size() <= 1000;
        allow update: if isAdmin();
        allow delete: if isAdmin() || (isSignedIn() && existing().senderId == request.auth.uid);
      }
    }

    // --- Verification Requests ---
    match /verificationRequests/{reqId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Reports Collection ---
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // --- Financial Ledger Transactions ---
    match /transactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid || (existing().creatorId != null && existing().creatorId == request.auth.uid));
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
    }

    // --- Admins collection ---
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Test connection doc
    match /test/{docId} {
      allow read: if true;
    }
  }
}
